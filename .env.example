# Copy this file to .env and fill only the providers you use.

# Recommended default. DeepSeek uses its Anthropic-compatible endpoint.
NANO_DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
NANO_DEEPSEEK_API_KEY=
NANO_DEEPSEEK_MODEL=deepseek-v4-pro
# Maximum native web searches per DeepSeek request. Set to 0 to disable.
NANO_DEEPSEEK_WEB_SEARCH_MAX_USES=5

# Optional right.codes shared key. Used by --provider openai and --provider anthropic when provider-specific keys are empty.
NANO_RIGHT_CODES_API_KEY=

# Default OpenAI-compatible endpoint. Change this if you use another /responses-compatible service.
NANO_OPENAI_API_BASE=https://www.right.codes/codex/v1
NANO_OPENAI_API_KEY=
NANO_OPENAI_MODEL=gpt-5.4

# Default Anthropic-compatible endpoint. Can reuse NANO_RIGHT_CODES_API_KEY when your gateway shares one key.
NANO_ANTHROPIC_API_BASE=https://www.right.codes/claude/v1
NANO_ANTHROPIC_API_KEY=
NANO_ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional comma-separated extra env names to redact from traces and reports.
NANO_SECRET_ENV_NAMES=

# Agent turn and step limits. Leave either NANO_MAX_STEPS or NANO_MAX_TURNS empty for no limit.
NANO_MAX_STEPS=
NANO_MAX_NEW_TOKENS=32000
NANO_MAX_FINAL_TOKENS=2048
NANO_MAX_TURNS=
NANO_MAX_FINAL_RETRIES=1
NANO_MAX_PROTOCOL_RETRIES=3
NANO_MAX_INVALID_TOOL_CALLS=3
NANO_MAX_AUTO_EXTENSIONS=1
NANO_AUTO_EXTENSION_STEPS=2
NANO_AUTO_EXTENSION_MAX_STEPS=10
NANO_DUPLICATE_READ_LIMIT=2
NANO_EXPLORER_LIST_FILES_LIMIT=5
NANO_MIN_EXPLORER_STEPS=2
NANO_MAX_INITIAL_EXPLORER_STEPS=8
NANO_INITIAL_WORKER_STEPS=6
NANO_MAX_INITIAL_WORKER_STEPS=10
NANO_INITIAL_DEFAULT_STEPS=3
NANO_MAX_AGENT_DEPTH=1
NANO_PROVIDER_MAX_RETRIES=3
