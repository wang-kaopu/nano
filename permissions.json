{
  "permissions": {
    "tools": {
      "allow": ["read_file", "list_files", "search", "grep_search", "write_file"],
      "deny": []
    },
    "shell": {
      "allow": [
        "npm test*",
        "npm run check*",
        "npm run build*",
        "pnpm test*",
        "pnpm run check*",
        "pnpm run build*",
        "yarn test*",
        "yarn run check*",
        "yarn run build*",
        "pytest*",
        "ruff*",
        "pyright*",
        "mypy*",
        "eslint*",
        "tsc*",
        "vitest*",
        "jest*",
        "uv run pytest*",
        "cargo test*",
        "cargo check*",
        "cargo build*",
        "go test*",
        "make test*",
        "make check*",
        "make build*",
        "git status*",
        "git diff*",
        "git log*",
        "git show*",
        "git rev-parse*",
        "rg*",
        "grep*",
        "ls*",
        "cat*",
        "pwd",
        "echo*",
        "printf*"
      ],
      "deny": []
    }
  }
}
