        "pnpm run build*",
        "pnpm run lint*",
        "pnpm run typecheck*",
        "yarn test*",
        "yarn run check*",
        "yarn run build*",
        "yarn run lint*",
        "yarn run typecheck*",
        "pytest*",
        "ruff*",
        "pyright*",
        "mypy*",
        ".venv/bin/pytest*",
        ".venv/bin/ruff*",
        ".venv/bin/pyright*",
        ".venv/bin/mypy*",
        "eslint*",
        "tsc*",
        "vitest*",
        "jest*",
        "uv run pytest*",
        "uv run ruff*",
        "uv run pyright*",
        "uv run mypy*",
        "uv run python -m pytest*",
        "uv run python -m compileall*",
