        "git blame*",
        "git config --get*",
        "git config --list*",
        "git remote -v",
        "git remote get-url*",
        "git worktree list*",
        "rg*",
        "grep*",
        "ls*",
        "cat*",
        "head*",
        "tail*",
        "wc*",
        "stat*",
        "file*",
        "diff*",
        "pwd",
        "echo*",
        "printf*"
